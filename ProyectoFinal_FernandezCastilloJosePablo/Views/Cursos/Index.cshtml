@model IEnumerable<Curso>
@{
    ViewData["Title"] = "Cursos";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">📚 Cursos</h1>
    <a asp-action="Crear" class="btn btn-dorado">+ Registrar curso</a>
</div>
<form method="get" class="row g-2 mb-3">
    <div class="col-md-4"><input name="buscar" value="@ViewBag.Buscar" class="form-control" placeholder="🔍 Buscar por código o nombre" /></div>
    <div class="col-md-3">
        <select name="carreraId" asp-items="@((SelectList)ViewBag.Carreras)" class="form-select">
            <option value="">Todas las carreras</option>
        </select>
    </div>
    <div class="col-auto"><button class="btn btn-uhcr">Filtrar</button> <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a></div>
</form>
<table class="table tabla-uhcr align-middle">
    <thead><tr><th>Código</th><th>Curso</th><th>Carrera</th><th>Créd.</th><th>Cupo</th><th>Horario</th><th>Docente</th><th class="text-end">Acciones</th></tr></thead>
    <tbody>
    @foreach (var c in Model)
    {
        <tr>
            <td>@c.Codigo</td>
            <td>@c.Nombre</td>
            <td>@c.Carrera?.Nombre</td>
            <td>@c.Creditos</td>
            <td>@c.CupoMaximo</td>
            <td>@c.Horario</td>
            <td>@if (c.Docente != null) { <span>@c.Docente.Nombre</span> } else { <span class="badge bg-warning text-dark">Sin asignar</span> }</td>
            <td class="text-end">
                <a asp-action="Editar" asp-route-id="@c.Id" class="btn btn-sm btn-uhcr">✏️ Editar</a>
                <form asp-action="Eliminar" asp-route-id="@c.Id" method="post" class="d-inline" onsubmit="return confirm('¿Desea eliminar este curso?');">
                    <button type="submit" class="btn btn-sm btn-outline-danger">🗑️ Eliminar</button>
                </form>
            </td>
        </tr>
    }
    @if (!Model.Any())
    {
        <tr><td colspan="8" class="text-center text-muted">No se encontraron cursos.</td></tr>
    }
    </tbody>
</table>
