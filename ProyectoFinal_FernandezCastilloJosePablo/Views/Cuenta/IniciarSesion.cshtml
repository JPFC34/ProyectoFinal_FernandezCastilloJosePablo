@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
}
<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="formulario-uhcr">
            <div class="text-center mb-3"><span class="logo-uh grande">UH</span></div>
            <h2 class="text-center">Iniciar sesión</h2>
            <form asp-action="IniciarSesion" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="mb-3">
                    <label asp-for="Correo" class="form-label"></label>
                    <input asp-for="Correo" class="form-control" autocomplete="username" />
                    <span asp-validation-for="Correo" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Contrasena" class="form-label"></label>
                    <input asp-for="Contrasena" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Contrasena" class="text-danger"></span>
                </div>
                <div class="form-check mb-3">
                    <input asp-for="Recordarme" class="form-check-input" />
                    <label asp-for="Recordarme" class="form-check-label"></label>
                </div>
                <button type="submit" class="btn btn-dorado w-100">Ingresar</button>
            </form>
            <p class="text-center mt-3 mb-0">¿Aún no tienes cuenta? <a asp-action="Registro">Regístrate aquí</a></p>
        </div>
    </div>
</div>
@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
