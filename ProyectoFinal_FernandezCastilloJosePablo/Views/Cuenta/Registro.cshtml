@model RegistroViewModel
@{
    ViewData["Title"] = "Registro de estudiante";
}
<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="formulario-uhcr">
            <h2 class="text-center">Registro de estudiante</h2>
            <p class="text-center text-muted">Crea tu cuenta y selecciona la carrera que deseas cursar.</p>
            <form asp-action="Registro" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="row">
                    <div class="col-md-8 mb-3">
                        <label asp-for="NombreCompleto" class="form-label"></label>
                        <input asp-for="NombreCompleto" class="form-control" />
                        <span asp-validation-for="NombreCompleto" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Cedula" class="form-label"></label>
                        <input asp-for="Cedula" class="form-control" />
                        <span asp-validation-for="Cedula" class="text-danger"></span>
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="Correo" class="form-label"></label>
                    <input asp-for="Correo" class="form-control" autocomplete="username" />
                    <span asp-validation-for="Correo" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="CarreraId" class="form-label"></label>
                    <select asp-for="CarreraId" asp-items="@((SelectList)ViewBag.Carreras)" class="form-select">
                        <option value="0">-- Seleccione su carrera --</option>
                    </select>
                    <span asp-validation-for="CarreraId" class="text-danger"></span>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Contrasena" class="form-label"></label>
                        <input asp-for="Contrasena" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Contrasena" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="ConfirmarContrasena" class="form-label"></label>
                        <input asp-for="ConfirmarContrasena" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmarContrasena" class="text-danger"></span>
                    </div>
                </div>
                <small class="text-muted d-block mb-3">La contraseña debe tener al menos 6 caracteres, una mayúscula, una minúscula, un número y un símbolo.</small>
                <button type="submit" class="btn btn-dorado w-100">Crear cuenta</button>
            </form>
            <p class="text-center mt-3 mb-0">¿Ya tienes cuenta? <a asp-action="IniciarSesion">Inicia sesión</a></p>
        </div>
    </div>
</div>
@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
