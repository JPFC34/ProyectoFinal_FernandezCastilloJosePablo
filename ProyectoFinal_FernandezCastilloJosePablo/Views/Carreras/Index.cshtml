@model IEnumerable<Carrera>
@{
    ViewData["Title"] = "Carreras";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">🎓 Carreras</h1>
    <a asp-action="Crear" class="btn btn-dorado">+ Registrar carrera</a>
</div>
<form method="get" class="row g-2 mb-3">
    <div class="col-md-5"><input name="buscar" value="@ViewBag.Buscar" class="form-control" placeholder="🔍 Buscar por código o nombre" /></div>
    <div class="col-auto"><button class="btn btn-uhcr">Buscar</button> <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a></div>
</form>
<table class="table tabla-uhcr align-middle">
    <thead><tr><th>Código</th><th>Carrera</th><th>Ciclos</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
    <tbody>
    @foreach (var c in Model)
    {
        <tr>
            <td>@c.Codigo</td>
            <td>@c.Nombre</td>
            <td>@c.CantidadCiclos</td>
            <td>@if (c.Activa) { <span class="badge badge-ok">Activa</span> } else { <span class="badge bg-secondary">Inactiva</span> }</td>
            <td class="text-end">
                <a asp-action="Editar" asp-route-id="@c.Id" class="btn btn-sm btn-uhcr">✏️ Editar</a>
                <form asp-action="Eliminar" asp-route-id="@c.Id" method="post" class="d-inline" onsubmit="return confirm('¿Desea eliminar esta carrera?');">
                    <button type="submit" class="btn btn-sm btn-outline-danger">🗑️ Eliminar</button>
                </form>
            </td>
        </tr>
    }
    @if (!Model.Any())
    {
        <tr><td colspan="5" class="text-center text-muted">No se encontraron carreras.</td></tr>
    }
    </tbody>
</table>
