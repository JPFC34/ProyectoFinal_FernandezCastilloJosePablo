@model IEnumerable<Docente>
@{
    ViewData["Title"] = "Docentes";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">👨‍🏫 Docentes</h1>
    <a asp-action="Crear" class="btn btn-dorado">+ Registrar docente</a>
</div>
<form method="get" class="row g-2 mb-3">
    <div class="col-md-5"><input name="buscar" value="@ViewBag.Buscar" class="form-control" placeholder="🔍 Buscar por nombre, correo o especialidad" /></div>
    <div class="col-auto"><button class="btn btn-uhcr">Buscar</button> <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a></div>
</form>
<table class="table tabla-uhcr align-middle">
    <thead><tr><th>Nombre</th><th>Correo</th><th>Especialidad</th><th>Cursos asignados</th><th class="text-end">Acciones</th></tr></thead>
    <tbody>
    @foreach (var d in Model)
    {
        <tr>
            <td>@d.Nombre</td>
            <td>@d.Correo</td>
            <td>@d.Especialidad</td>
            <td><span class="badge badge-azul">@d.Cursos.Count</span></td>
            <td class="text-end">
                <a asp-action="Editar" asp-route-id="@d.Id" class="btn btn-sm btn-uhcr">✏️ Editar</a>
                <form asp-action="Eliminar" asp-route-id="@d.Id" method="post" class="d-inline" onsubmit="return confirm('¿Desea eliminar este docente?');">
                    <button type="submit" class="btn btn-sm btn-outline-danger">🗑️ Eliminar</button>
                </form>
            </td>
        </tr>
    }
    @if (!Model.Any())
    {
        <tr><td colspan="5" class="text-center text-muted">No se encontraron docentes.</td></tr>
    }
    </tbody>
</table>
